Project enterprise_operation_platform {
  database_type: 'PostgreSQL'
  Note: 'Foundational organization, IAM, catalog, vendor, and audit schema.'
}

// PostgreSQL extension required by the UUID defaults below.
// CREATE EXTENSION IF NOT EXISTS pgcrypto;

Table organization.companies {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  legal_name varchar(255)
  registration_number varchar(100)
  tax_identification_number varchar(100)
  industry varchar(100)
  country_code char(2) [not null, default: 'NG']
  default_currency char(3) [not null, default: 'NGN']
  timezone varchar(100) [not null, default: 'Africa/Lagos']
  status varchar(30) [not null, default: 'active', note: 'active, suspended, or inactive']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    status
  }
}

Table organization.departments {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid [not null]
  name varchar(150) [not null]
  code varchar(50)
  manager_company_user_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, name) [unique]
    (company_id, code) [unique]
  }
}

Table organization.locations {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid [not null]
  name varchar(150) [not null]
  code varchar(50) [not null]
  type varchar(50) [not null, default: 'office', note: 'office, warehouse, branch, site, factory, or other']
  address text
  city varchar(100)
  state varchar(100)
  country_code char(2)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, code) [unique]
  }
}

Table iam.users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(50)
  status varchar(30) [not null, default: 'active', note: 'active, suspended, or inactive']
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table iam.company_users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid [not null]
  user_id uuid [not null]
  department_id uuid
  employee_number varchar(100)
  job_title varchar(150)
  status varchar(30) [not null, default: 'active', note: 'active, suspended, or inactive']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, user_id) [unique]
    (company_id, employee_number) [unique]
  }
}

Table iam.roles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table iam.permissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(150) [not null, unique]
  description text
  created_at timestamptz [not null, default: `now()`]
}

Table iam.user_roles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  company_user_id uuid [not null]
  role_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (company_user_id, role_id) [unique]
  }
}

Table iam.role_permissions {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  role_id uuid [not null]
  permission_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (role_id, permission_id) [unique]
  }
}

Table catalog.item_categories {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid [not null]
  parent_id uuid
  name varchar(150) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, name) [unique]
  }
}

Table catalog.units_of_measure {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  code varchar(20) [not null, unique]
  name varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table catalog.items {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid [not null]
  category_id uuid
  unit_of_measure_id uuid [not null]
  sku varchar(100)
  name varchar(255) [not null]
  description text
  item_type varchar(30) [not null, default: 'material', note: 'material, service, or asset']
  is_stockable boolean [not null, default: true]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, sku) [unique]
  }
}

Table vendor.suppliers {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  legal_name varchar(255) [not null]
  trading_name varchar(255)
  registration_number varchar(100)
  tax_identification_number varchar(100)
  supplier_type varchar(50)
  country_code char(2)
  status varchar(30) [not null, default: 'active', note: 'active, inactive, or suspended']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vendor.supplier_company_profiles {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  supplier_id uuid [not null]
  company_id uuid [not null]
  supplier_code varchar(100)
  relationship_status varchar(30) [not null, default: 'prospective', note: 'prospective, active, suspended, blocked, or inactive']
  onboarding_status varchar(30) [not null, default: 'pending', note: 'pending, in_progress, completed, or rejected']
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (supplier_id, company_id) [unique]
    (company_id, supplier_code) [unique]
  }
}

Table vendor.supplier_contacts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  supplier_id uuid [not null]
  name varchar(200) [not null]
  email varchar(255)
  phone varchar(50)
  position varchar(150)
  is_primary boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vendor.supplier_documents {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  supplier_id uuid [not null]
  supplier_company_profile_id uuid
  document_type varchar(100) [not null]
  document_number varchar(150)
  file_url text [not null]
  file_hash varchar(128)
  issued_at date
  expires_at date
  status varchar(30) [not null, default: 'pending', note: 'pending, valid, expired, or rejected']
  uploaded_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vendor.verification_cases {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  supplier_company_profile_id uuid [not null]
  case_number varchar(100) [not null, unique]
  verification_type varchar(50) [not null, default: 'initial']
  status varchar(30) [not null, default: 'open', note: 'open, in_progress, approved, rejected, expired, or cancelled']
  opened_by uuid [not null]
  opened_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vendor.verification_checks {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  verification_case_id uuid [not null]
  check_type varchar(100) [not null]
  name varchar(150) [not null]
  status varchar(30) [not null, default: 'pending', note: 'pending, in_progress, passed, failed, or waived']
  is_required boolean [not null, default: true]
  checked_by uuid
  checked_at timestamptz
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table vendor.verification_evidence {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  verification_check_id uuid [not null]
  supplier_document_id uuid
  evidence_type varchar(100) [not null]
  file_url text
  description text
  uploaded_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table vendor.verification_reviews {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  verification_case_id uuid [not null]
  reviewer_user_id uuid [not null]
  decision varchar(30) [not null, note: 'approved, rejected, or requires_changes']
  comments text
  reviewed_at timestamptz [not null, default: `now()`]
}

Table vendor.supplier_risk_assessments {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  verification_case_id uuid [not null]
  risk_level varchar(30) [not null, note: 'low, medium, high, or critical']
  risk_score numeric(5,2)
  rationale text
  assessed_by uuid [not null]
  assessed_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
}

Table audit.audit_logs {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid
  user_id uuid
  action varchar(100) [not null]
  entity_type varchar(100) [not null]
  entity_id uuid
  old_values jsonb
  new_values jsonb
  ip_address inet
  user_agent text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (company_id, created_at)
    (entity_type, entity_id)
  }
}

Ref: organization.departments.company_id > organization.companies.id
Ref: organization.departments.manager_company_user_id > iam.company_users.id
Ref: organization.locations.company_id > organization.companies.id
Ref: iam.company_users.company_id > organization.companies.id
Ref: iam.company_users.user_id > iam.users.id
Ref: iam.company_users.department_id > organization.departments.id
Ref: iam.user_roles.company_user_id > iam.company_users.id [delete: cascade]
Ref: iam.user_roles.role_id > iam.roles.id [delete: cascade]
Ref: iam.role_permissions.role_id > iam.roles.id [delete: cascade]
Ref: iam.role_permissions.permission_id > iam.permissions.id [delete: cascade]
Ref: catalog.item_categories.company_id > organization.companies.id
Ref: catalog.item_categories.parent_id > catalog.item_categories.id
Ref: catalog.items.company_id > organization.companies.id
Ref: catalog.items.category_id > catalog.item_categories.id
Ref: catalog.items.unit_of_measure_id > catalog.units_of_measure.id
Ref: vendor.supplier_company_profiles.supplier_id > vendor.suppliers.id
Ref: vendor.supplier_company_profiles.company_id > organization.companies.id
Ref: vendor.supplier_contacts.supplier_id > vendor.suppliers.id [delete: cascade]
Ref: vendor.supplier_documents.supplier_id > vendor.suppliers.id [delete: cascade]
Ref: vendor.supplier_documents.supplier_company_profile_id > vendor.supplier_company_profiles.id
Ref: vendor.supplier_documents.uploaded_by > iam.users.id
Ref: vendor.verification_cases.supplier_company_profile_id > vendor.supplier_company_profiles.id
Ref: vendor.verification_cases.opened_by > iam.users.id
Ref: vendor.verification_checks.verification_case_id > vendor.verification_cases.id [delete: cascade]
Ref: vendor.verification_checks.checked_by > iam.users.id
Ref: vendor.verification_evidence.verification_check_id > vendor.verification_checks.id [delete: cascade]
Ref: vendor.verification_evidence.supplier_document_id > vendor.supplier_documents.id
Ref: vendor.verification_evidence.uploaded_by > iam.users.id
Ref: vendor.verification_reviews.verification_case_id > vendor.verification_cases.id [delete: cascade]
Ref: vendor.verification_reviews.reviewer_user_id > iam.users.id
Ref: vendor.supplier_risk_assessments.verification_case_id > vendor.verification_cases.id [delete: cascade]
Ref: vendor.supplier_risk_assessments.assessed_by > iam.users.id
Ref: audit.audit_logs.company_id > organization.companies.id
Ref: audit.audit_logs.user_id > iam.users.id

