  companies                                                        companies       @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company_users_departments_manager_company_user_idTocompany_users company_users?  @relation("departments_manager_company_user_idTocompany_users", fields: [manager_company_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_departments_manager")
  requisitions                                                     requisitions[]

  @@unique([company_id, code], map: "uq_departments_company_code")
  @@unique([company_id, name], map: "uq_departments_company_name")
