NODE_ENV=development
PORT=3001
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000

# RFQ invitation, quotation and closure email. In-app notifications remain available without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# PostgreSQL connection (used by TypeORM and the legacy pg Pool)
PGHOST=localhost
PGPORT=5432
PGDATABASE=enterprise_operations
PGUSER=enterprise_app
PGPASSWORD="REPLACE_WITH_YOUR_LOCAL_PASSWORD"

# TypeORM-specific URL overrides the individual PG* vars if set
DATABASE_URL=

# Private uploaded supplier listing photos (use persistent private storage in deployment)
SUPPLIER_LISTING_STORAGE_DIR=private/supplier-listing-photos
