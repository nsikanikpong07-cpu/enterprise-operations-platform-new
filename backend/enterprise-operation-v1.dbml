//   IN ('Pending', 'Approved', 'Rejected'))
 
// CHECK (procurement.requisitions.total_estimated_amount
//   IS NULL OR total_estimated_amount >= 0)
 
// CHECK (procurement.requisition_items.quantity_requested
//   > 0)
 
// CHECK (procurement.requisition_items.estimated_unit_price
